    "apisauce": "3.1.1",
    "axios": "^1.13.5",
    "date-fns": "^4.1.0",
    "expo": "~54.0.31",
    "expo-application": "~7.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.12",
    "expo-document-picker": "~14.0.8",
