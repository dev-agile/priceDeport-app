    "posthog-react-native": "^4.41.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.45.4",
    "react-i18next": "^15.0.1",
    "react-native": "0.81.5",
    "react-native-asset": "^2.1.1",
